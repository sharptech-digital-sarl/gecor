# =============================================================================
# GECOR frontend — exemple de variables d'environnement
# Copier en `frontend/.env`. Les variables sont injectées au BUILD par Vite.
# Redémarrer `npm run dev` après modification en développement.
# =============================================================================

# URL de base de l'API backend. Doit inclure `/api/v1`.
# - Dev local (backend Uvicorn sans Docker)  : http://localhost:8000/api/v1
# - Dev local (Docker Compose, port 8001)    : http://localhost:8001/api/v1
# - Prod derrière le reverse proxy Nginx     : /api/v1
VITE_API_URL=http://localhost:8000/api/v1

# development | production
NODE_ENV=development
