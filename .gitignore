# =============================================================================
# GECOR — fichiers ignorés par Git
# =============================================================================

# -- Secrets et environnement -------------------------------------------------
.env
.env.local
.env.*.local
*.env.local
*.pem
*.key
*.crt

# -- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-*/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
dist/
build/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# -- Node / Vite --------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnp.*
.yarn/
frontend/dist/
frontend/.vite/

# -- IDE / Editeurs -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# -- Windows : Zone Identifier ------------------------------------------------
*:Zone.Identifier
*.Zone.Identifier

# -- Stockage applicatif (à exclure du dépôt) --------------------------------
backend/storage/mail/
backend/storage/qr/
backend/storage/visitor/
backend/storage/*/
!backend/storage/.gitkeep

# -- Sauvegardes locales ------------------------------------------------------
backups/
*.dump
*.dump.gz
*.sql.gz

# -- Logs ---------------------------------------------------------------------
logs/
*.log

# -- Alembic local ------------------------------------------------------------
# garder le code des migrations, mais pas les artefacts éventuels

# -- Outils & artefacts ponctuels ---------------------------------------------
poppler-25.12.0/
schema.yaml
.openapi-export/
