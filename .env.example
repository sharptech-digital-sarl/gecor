# =============================================================================
# GECOR — fichier d'exemple pour les variables d'environnement (racine du dépôt)
# Copiez-le en `.env` (racine) puis chargez-le via docker compose ou export.
# Pour le backend en mode local sans Docker, dupliquer le bloc « Backend »
# dans backend/.env (voir backend/.env.example).
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose (lecture par docker-compose.yml)
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-generate-a-long-random-string
VITE_API_URL=http://localhost:8001/api/v1

# -----------------------------------------------------------------------------
# Base de données PostgreSQL (utilisée par le backend + Alembic)
# Pour un mot de passe avec des caractères spéciaux (#, @, %, …) penser à
# l'URL-encoder dans DATABASE_URL ( # -> %23, @ -> %40, etc.).
# -----------------------------------------------------------------------------
POSTGRES_USER=gecor-admin
POSTGRES_PASSWORD=changez-ce-mot-de-passe
POSTGRES_DB=gecor_connect
DATABASE_URL=postgresql://gecor-admin:changez-ce-mot-de-passe@db:5432/gecor_connect

# -----------------------------------------------------------------------------
# Redis (Celery + cache rate-limit + SSE)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Réseau / CORS (séparé par virgules ou tableau JSON)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Stockage des fichiers (local par défaut, MinIO/S3 en option)
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=gecor-files

# -----------------------------------------------------------------------------
# Sécurité / tokens
# -----------------------------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_SAMESITE=lax
# false en HTTP local (sans TLS), true en production HTTPS
REFRESH_TOKEN_SECURE=false
MFA_SESSION_EXPIRE_MINUTES=10
# Rôles forçant l'enrôlement MFA (JSON ou CSV, ex : ["master","director"])
MFA_REQUIRED_ROLES=[]

# -----------------------------------------------------------------------------
# SMTP (notifications, rappels, validation MFA email)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@gecor.local
# SMTP_USE_TLS=true

# Langue par défaut des e-mails transactionnels (fr | en)
DEFAULT_NOTIFICATION_LOCALE=fr

# -----------------------------------------------------------------------------
# OCR (Tesseract + Poppler pour les PDF)
# -----------------------------------------------------------------------------
# Linux/macOS conteneur :
TESSERACT_CMD=/usr/bin/tesseract
# Windows : C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANGUAGE=fra+eng

# -----------------------------------------------------------------------------
# Intégrations externes (toutes optionnelles)
# -----------------------------------------------------------------------------
# Google Calendar (OAuth web)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# Microsoft Graph / Exchange
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT_ID=
# EXCHANGE_SERVER_URL=
# EXCHANGE_USERNAME=
# EXCHANGE_PASSWORD=

# LDAP / Active Directory
# LDAP_SERVER=ldap://your-ldap-server
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_DN=
# LDAP_GROUP_DN=

# -----------------------------------------------------------------------------
# Web Push (VAPID) — facultatif, requis pour les notifications navigateur
# Générer la paire avec : npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gecor.local

# -----------------------------------------------------------------------------
# Reverse proxy
# Mettre à false si l'API n'est pas derrière un reverse-proxy de confiance.
# -----------------------------------------------------------------------------
TRUST_FORWARDED_HEADERS=true
