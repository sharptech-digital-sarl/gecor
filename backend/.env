# FPI-CONNECT backend — variables alignées sur l’ancien docker-compose (exécution locale)
# Mot de passe PostgreSQL en clair : Fpi-c05b6q#  (dans DATABASE_URL, # → %23)

# --- Obligatoire ---
SECRET_KEY=O8Mo9l8U2JxxJf_Oat_DX-dUpHLDjLYM3eLlwyDF8wE

# Port 5432 = défaut PostgreSQL installé sur Windows. (5435 = ancien mapping Docker uniquement.)
DATABASE_URL=postgresql://fpi-admin:Fpi-c05b6q%23@localhost:5432/fpi_connect

REDIS_URL=redis://localhost:6380/0

# JSON (tableau) ou liste séparée par des virgules
CORS_ORIGINS=["http://localhost:3001","http://localhost:80"]

FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:8001

STORAGE_TYPE=local
STORAGE_PATH=./storage

# HTTP local sans TLS : le cookie refresh doit être non-secure
REFRESH_TOKEN_SECURE=false

# --- Sécurité / tokens (défauts applicatifs) ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_SAMESITE=lax
# REFRESH_TOKEN_COOKIE_DOMAIN=
MFA_SESSION_EXPIRE_MINUTES=10

# --- SMTP (optionnel) ---
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@fpi-connect.local
# SMTP_USE_TLS=true

# --- OCR ---
# Windows (chemin courant d’installation ; adapter si besoin) :
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/macOS : TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=fra+eng

