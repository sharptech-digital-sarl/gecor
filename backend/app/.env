REDIS_URL=redis://localhost:6380/0

# Une seule ligne JSON pour pydantic-settings (le tableau multiligne casse le parsing JSON).
CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://172.168.1.6:3000","http://172.168.1.6:80"]

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

STORAGE_TYPE=local
STORAGE_PATH=./storage

# HTTP local sans TLS : le cookie refresh doit être non-secure
REFRESH_TOKEN_SECURE=false

# --- Sécurité / tokens (défauts applicatifs) ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_SAMESITE=lax
# REFRESH_TOKEN_COOKIE_DOMAIN=
MFA_SESSION_EXPIRE_MINUTES=10

# --- SMTP (optionnel) ---
