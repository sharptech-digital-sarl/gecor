# =============================================================================
# GECOR backend — fichier d'exemple (exécution locale, sans Docker)
# Copier en `backend/.env` puis ajuster.
# Pour la version Docker Compose, voir `.env.example` à la racine du dépôt.
# =============================================================================

# --- Obligatoire ---
SECRET_KEY=change-me-generate-a-long-random-string
DATABASE_URL=postgresql://gecor-admin:changez-ce-mot-de-passe@localhost:5432/gecor_connect
REDIS_URL=redis://localhost:6379/0

# --- Réseau / CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Stockage ---
STORAGE_TYPE=local
STORAGE_PATH=./storage

# --- Sécurité / tokens ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_SAMESITE=lax
# false en HTTP local sans TLS
REFRESH_TOKEN_SECURE=false
MFA_SESSION_EXPIRE_MINUTES=10
MFA_REQUIRED_ROLES=[]

# --- SMTP (optionnel) ---
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@gecor.local
# SMTP_USE_TLS=true
DEFAULT_NOTIFICATION_LOCALE=fr

# --- OCR ---
# Linux : /usr/bin/tesseract
# Windows : C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=fra+eng

# --- MinIO / S3 (optionnel) ---
# STORAGE_TYPE=s3
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=gecor-files

# --- Intégrations externes (optionnelles) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT_ID=

# LDAP_SERVER=ldap://your-ldap-server
# LDAP_BASE_DN=dc=example,dc=com

# --- Web Push (VAPID, optionnel) ---
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gecor.local

# --- Reverse proxy ---
TRUST_FORWARDED_HEADERS=true
